# Copy this file to .env and fill in your real values.
# .env is gitignored — it will never be committed.
ANTHROPIC_API_KEY=your-api-key-here

# CMS login - pick ANY username/password you like, e.g. user1/s0mep@ssword.
# This is a human-facing login typed into a browser popup. It has nothing
# to do with GitHub - never put a GitHub token value in these two fields.
CMS_USERNAME=your-cms-username-here
CMS_PASSWORD=your-cms-password-here

# GitHub fine-grained PAT (Contents: Read and write, this repo only).
# This is a machine credential read only from this file by code - never
# type it into a browser login prompt or any UI field.
GITHUB_TOKEN=your-github-fine-grained-token-here
GITHUB_OWNER=andreilaqui
GITHUB_REPO=ticket-triage-agent
